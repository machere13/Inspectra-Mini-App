# Windows-friendly: укладывать пакеты плоско (без .pnpm store со 100500 симлинков).
# Убирает EPERM/EACCES'ы от Defender'а на свежесозданных temp-папках.
node-linker=hoisted

# Не падать если в lockfile нет ровно тех версий что в package.json
# (пригодится первое время после миграции с npm).
strict-peer-dependencies=false
